    { "id": "N05", "what": "days to hours at 8 hours, not 24", "unit": "consulting_h", "line": { "quantity": 10, "order_unit": "DAY", "net_price": 1200, "price_unit": 1, "currency": "EUR", "incoterm": null }, "price": 150, "base_units_per_order_unit": 8, "display": "€150.00 per H" },
